# Copy to .env for local overrides. Defaults run GPU-free with an inline queue.
APP_ENVIRONMENT=development

# Queue (Redis). In dev the task runs inline; set eager=false to use a real worker.
APP_CELERY_BROKER_URL=redis://localhost:6379/0
APP_CELERY_RESULT_BACKEND=redis://localhost:6379/1
APP_CELERY_TASK_ALWAYS_EAGER=true

# Object store
APP_OBJECT_STORE_BUCKET=avatar-video-dev

# Model backends. "mock" = no GPU. Swap for real adapters once wired:
#   tts:     kokoro_82m | f5_tts | cosyvoice2
#   lipsync: latentsync | musetalk
APP_TTS_BACKEND=mock
APP_LIPSYNC_BACKEND=mock
APP_SCRIPT_BACKEND=mock

# Provenance / output ceilings (PRD §6, §8)
APP_FORCE_VISIBLE_WATERMARK=true
APP_MAX_OUTPUT_SECONDS=300
APP_MAX_OUTPUT_HEIGHT=1080
